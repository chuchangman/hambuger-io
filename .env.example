# ⚠️ 이 파일은 "예시"입니다. 실제 키를 여기에 넣지 마세요.
#    이 파일은 git 에 올라갑니다. 실제 키는 .env 에만 넣으세요. (.env 는 .gitignore 됨)
#
#    사용법:  cp .env.example .env   →  .env 를 열어 키를 채웁니다.

# ── Google Gemini (Google AI Studio) ────────────────────────
# https://aistudio.google.com/apikey 에서 발급받은 키
# 키가 없어도 게임은 "오프라인 규칙 기반 손님"으로 정상 플레이됩니다.
GEMINI_API_KEY=

# 사용할 모델 (선택). 기본값 gemini-flash-lite-latest
# (실측 응답 ~1.3초. gemini-flash-latest 는 느리고 무료 등급이 분당 5회라 게임에 부적합)
# 키에서 안 되는 모델이면 `npm run check:llm` 이 쓸 수 있는 목록을 알려줍니다.
# GEMINI_MODEL=gemini-flash-lite-latest

# 응답 대기 제한 (선택, 밀리초). 기본 20000
# GEMINI_TIMEOUT_MS=20000

# ── 서버 ────────────────────────────────────────────────────
# 서버 포트 (기본 3210)
PORT=3210
